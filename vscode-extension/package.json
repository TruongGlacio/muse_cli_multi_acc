    "configuration": {
      "properties": {
        "muse.apiKey": {
          "default": "",
          "description": "API key của gateway. Để trống: extension tự sinh và lưu key riêng cho gateway kèm theo trong SecretStorage của VS Code; chỉ cần dán key khi dùng gateway ngoài chạy sẵn mà key không khớp.",
          "type": "string"
        },
        "muse.autoApprove": {
          "default": false,
          "description": "Bật để tự duyệt mọi thao tác ghi tệp và chạy lệnh. Mặc định là tắt: mỗi thao tác ghi/chạy đều hỏi duyệt, và thao tác sửa tệp có nút Xem diff.",
          "type": "boolean"
        },
        "muse.localTools": {
          "type": "boolean",
          "default": true,
          "description": "Bật tool cục bộ cho agent (đọc/sửa/chạy trong workspace). Tắt (false) thì agent chỉ trò chuyện: không dùng tool, không quét workspace, không gửi dữ liệu workspace lên model qua tool. Đổi nhanh bằng lệnh 'Muse: Bật/Tắt tool cục bộ'."
        },
        "muse.baseUrl": {
          "default": "http://127.0.0.1:18610/v1",
          "description": "Địa chỉ gateway Muse2Api, gồm /v1. Mặc định http://127.0.0.1:18610/v1. Ở chế độ auto/bundled, extension tự khởi động gateway kèm theo trên cổng này khi mở VS Code nếu chưa có gateway nào chạy.",
          "type": "string"
        },
        "muse.commandTimeoutSeconds": {
          "default": 120,
          "description": "Thời gian chờ tối đa cho mỗi lệnh chạy trong workspace.",
          "type": "number"
        },
        "muse.maxSteps": {
          "default": 30,
          "description": "Số bước tool tối đa trong một yêu cầu.",
          "type": "number"
        },
        "muse.model": {
          "default": "muse-chat",
          "description": "Tên model gửi tới gateway.",
          "type": "string"
        },
        "muse.gatewayMode": {
          "default": "auto",
          "description": "Cách extension lấy gateway. auto (mặc định): dùng gateway sẵn có nếu đã chạy và key khớp, nếu không thì tự chạy gateway kèm theo. bundled: luôn tự chạy gateway kèm theo khi chưa có gateway nào. external: không bao giờ tự chạy, chỉ dùng gateway ngoài.",
          "enum": [
            "auto",
            "bundled",
            "external"
          ],
          "type": "string"
        },
        "muse.gatewayPath": {
          "default": "",
          "description": "Đường dẫn tới file thực thi gateway Muse2Api tự chọn. Để trống thì dùng binary kèm theo extension (bin/win-x64/Muse2Api.exe trên Windows x64).",
          "type": "string"
        },
        "muse.allowComputerControl": {
          "default": false,
          "description": "THỬ NGHIỆM, chỉ Windows: cho phép extension điều khiển màn hình qua helper .NET riêng. Mặc định TẮT. Khi bật, mỗi hành động bấm/gõ vẫn hỏi duyệt modal riêng, kể cả khi muse.autoApprove bật. Tắt thì computer_* trả lỗi rõ ràng, hướng về app desktop.",
          "type": "boolean"
        },
        "muse.computerHelperPath": {
          "default": "",
          "description": "Đường dẫn tới Muse2Api.ComputerHelper.exe tự chọn. Để trống thì dùng helper kèm theo extension (bin/win-x64/computer-helper/Muse2Api.ComputerHelper.exe).",
          "type": "string"
        }
      },
      "title": "Muse"
    },
    "views": {
      "muse": [
        {
          "id": "muse.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "muse",
          "title": "Muse",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "description": "Chat, đọc dự án, sửa tệp và chạy kiểm tra trong VS Code qua gateway Muse2Api kèm theo, tự chạy khi mở VS Code (tài khoản Muse).",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  },
  "displayName": "Muse",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "name": "muse-vscode",
  "publisher": "thanhtaiinguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/thanhtaiinguyen/muse_cli.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./"
  },
  "version": "0.8.19",
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
